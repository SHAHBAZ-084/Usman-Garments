generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  KACHI
  PURCHASE_MAAL
  SALE
  SALE_RETURN
  PURCHASE
  PURCHASE_RETURN
  EXCHANGE
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  EXPENSE
  OTHER_INCOME
  ADJUSTMENT
}

enum VoucherStatus {
  ACTIVE
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum FinancialYearStatus {
  ACTIVE
  CLOSED
}

enum ReceiptSize {
  THERMAL_58
  THERMAL_80
  A4
}

enum ThemeMode {
  LIGHT
  DARK
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vouchersCreated       Voucher[]              @relation("VoucherCreatedBy")
  vouchersModified      Voucher[]              @relation("VoucherModifiedBy")
  vouchersDeleted       Voucher[]              @relation("VoucherDeletedBy")
  financialYearsClosed  FinancialYear[]        @relation("FinancialYearClosedBy")
  trialBalanceApprovals TrialBalanceApproval[]
}

model AccountCategory {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  accounts Account[]
}

model Account {
  id         Int         @id @default(autoincrement())
  categoryId Int
  name       String
  code       String      @unique
  type       AccountType
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())

  category        AccountCategory               @relation(fields: [categoryId], references: [id])
  ledger          Ledger?
  debitVouchers   Voucher[]                     @relation("DebitAccount")
  creditVouchers  Voucher[]                     @relation("CreditAccount")
  closingBalances FinancialYearClosingBalance[]
}

model Ledger {
  id        Int      @id @default(autoincrement())
  accountId Int      @unique
  balance   Decimal  @default(0)
  updatedAt DateTime @updatedAt

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]
}

model LedgerEntry {
  id               Int             @id @default(autoincrement())
  ledgerId         Int
  voucherId        Int?
  type             LedgerEntryType
  amount           Decimal
  balance          Decimal
  notes            String?
  isReversal       Boolean         @default(false)
  isOpeningBalance Boolean         @default(false)
  createdAt        DateTime        @default(now())

  ledger  Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  voucher Voucher? @relation(fields: [voucherId], references: [id])

  @@index([ledgerId])
  @@index([createdAt])
}

model Voucher {
  id                Int           @id @default(autoincrement())
  type              VoucherType
  number            Int
  date              DateTime
  debitAccountId    Int?
  creditAccountId   Int?
  amount            Decimal
  description       String?
  /// Legacy free-text reference (kept for Payment/Receipt/Journal and older multi-leg vouchers).
  reference         String?
  /// Business document kind for linked posting groups, e.g. SALE, PURCHASE, CUSTOMER_PAYMENT.
  sourceType        String?
  /// Business document id/key within sourceType, e.g. invoice id or "TEST-SALE-1".
  sourceRef         String?
  status            VoucherStatus @default(ACTIVE)
  createdById       Int
  modifiedById      Int?
  deletedById       Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  financialYearId   Int?

  financialYear FinancialYear? @relation(fields: [financialYearId], references: [id])
  debitAccount  Account?       @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount Account?       @relation("CreditAccount", fields: [creditAccountId], references: [id])
  createdBy     User           @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  modifiedBy    User?          @relation("VoucherModifiedBy", fields: [modifiedById], references: [id])
  deletedBy     User?          @relation("VoucherDeletedBy", fields: [deletedById], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([financialYearId, type, number])
  @@index([financialYearId, type])
  @@index([date])
  @@index([createdAt])
  @@index([status])
  @@index([sourceType, sourceRef])
  @@index([reference])
}

model FinancialYear {
  id         Int                 @id @default(autoincrement())
  label      String              @unique
  startDate  DateTime
  endDate    DateTime?
  status     FinancialYearStatus @default(ACTIVE)
  closedAt   DateTime?
  closedById Int?

  closedBy        User?                         @relation("FinancialYearClosedBy", fields: [closedById], references: [id])
  closingBalances FinancialYearClosingBalance[]
  vouchers        Voucher[]

  @@index([status])
}

model FinancialYearClosingBalance {
  id              Int     @id @default(autoincrement())
  financialYearId Int
  accountId       Int
  balance         Decimal

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  account       Account       @relation(fields: [accountId], references: [id])

  @@unique([financialYearId, accountId])
}

model TrialBalanceApproval {
  id           Int      @id @default(autoincrement())
  period       String   @unique
  approvedById Int
  notes        String?
  snapshot     Json
  createdAt    DateTime @default(now())

  approvedBy User @relation(fields: [approvedById], references: [id])
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  EXCHANGE
  MANUAL_ADD
  MANUAL_REDUCE
  DAMAGED
  CORRECTION
  CANCELLATION
}

/// Lightweight product grouping (separate from accounting AccountCategory).
model ProductCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  sku           String   @unique
  barcode       String?  @unique
  categoryId    Int?
  brand         String?
  purchasePrice Decimal
  salePrice     Decimal
  currentStock  Int      @default(0)
  lowStockLimit Int?
  /// Placeholder for Phase 5 Supplier FK — no relation yet.
  supplierId    Int?
  imagePath     String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([isActive])
  @@index([categoryId])
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  size          String?
  colour        String?
  sku           String   @unique
  barcode       String?  @unique
  purchasePrice Decimal?
  salePrice     Decimal?
  currentStock  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([productId])
}

model StockMovement {
  id         Int               @id @default(autoincrement())
  productId  Int
  variantId  Int?
  type       StockMovementType
  quantity   Int
  note       String?
  sourceType String?
  sourceRef  String?
  createdAt  DateTime          @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
  @@index([sourceType, sourceRef])
}

/// Singleton shop settings (always id = 1). Never create a second row.
model BusinessSettings {
  id                Int         @id @default(1)
  businessName      String      @default("Usman Mall")
  tagline           String      @default("Quality Clothes, Your Style")
  ownerName         String      @default("")
  phone             String      @default("0300-6195469")
  whatsapp          String      @default("0300-6195469")
  address           String      @default("Al-Nisa Road, Chishtian")
  invoiceFooter     String      @default("Thank you for shopping at Usman Mall")
  returnPolicy      String      @default("Returns accepted within 7 days with original receipt. Items must be unused and in original condition.")
  invoicePrefix     String      @default("UM-")
  currency          String      @default("PKR")
  receiptSize       ReceiptSize @default(THERMAL_80)
  a4InvoiceEnabled  Boolean     @default(true)
  printerName       String?
  barcodeLabelSize  String      @default("50x30")
  lowStockLimit     Int         @default(5)
  backupFolderPath  String      @default("")
  themeMode         ThemeMode   @default(LIGHT)
  logoPath          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}
